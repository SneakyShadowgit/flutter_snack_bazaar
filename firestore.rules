rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isAdmin() { return signedIn() && profile().role == 'admin'; }
    function approvedSeller() {
      return signedIn() && profile().role == 'seller' && profile().status == 'approved';
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.role == 'buyer'
        && !request.resource.data.keys().hasAny(['status', 'isAdmin']);
      allow update: if isAdmin() || (signedIn() && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.get('status', null) == resource.data.get('status', null)
        && request.resource.data.get('isAdmin', null) == resource.data.get('isAdmin', null));
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if signedIn() && (isAdmin() || profile().role == 'buyer'
        || (approvedSeller() && resource.data.sellerId == request.auth.uid));
      allow create: if approvedSeller() && request.resource.data.sellerId == request.auth.uid;
      allow update: if approvedSeller() && resource.data.sellerId == request.auth.uid
        && request.resource.data.sellerId == request.auth.uid;
      allow delete: if approvedSeller() && resource.data.sellerId == request.auth.uid;
    }

    match /orders/{orderId} {
      allow read: if signedIn() && (resource.data.buyerId == request.auth.uid
        || isAdmin()
        || (approvedSeller() && resource.data.sellerId == request.auth.uid));
      allow create: if signedIn()
        && profile().role == 'buyer'
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.paymentMethod == 'cash_on_delivery'
        && request.resource.data.paymentStatus == 'due_on_delivery'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && (!request.resource.data.keys().hasAny(['sellerId'])
          || (get(/databases/$(database)/documents/users/$(request.resource.data.sellerId)).data.role == 'seller'
            && get(/databases/$(database)/documents/users/$(request.resource.data.sellerId)).data.status == 'approved'));
      allow update: if isAdmin() || (approvedSeller()
        && resource.data.sellerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && ((resource.data.status == 'pending' && request.resource.data.status == 'packed')
          || (resource.data.status == 'packed' && request.resource.data.status == 'shipped')
          || (resource.data.status == 'shipped' && request.resource.data.status == 'delivered')));
      allow delete: if isAdmin();
    }

    match /sellerApplications/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn() && request.auth.uid == userId
        && profile().role == 'buyer'
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isAdmin() || (signedIn()
        && request.auth.uid == userId
        && resource.data.ownerId == request.auth.uid
        && resource.data.status == 'rejected'
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'pending');
      allow delete: if isAdmin();
    }

    match /{document=**} { allow read, write: if false; }
  }
}
